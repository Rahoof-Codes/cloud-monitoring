rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each user can only read/write files under their own uid path.
    match /users/{uid}/uploads/{allPaths=**} {
      // Read: authenticated user owns this path
      allow read: if request.auth != null && request.auth.uid == uid;

      // Write: authenticated owner + file under 200 MB + contentType must be set
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType != null;
    }
  }
}
