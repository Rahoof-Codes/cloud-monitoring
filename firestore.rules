rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read/write their own document tree.
    // This covers /users/{uid}, /users/{uid}/resources/{resourceId},
    // and /users/{uid}/files/{fileId}.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
